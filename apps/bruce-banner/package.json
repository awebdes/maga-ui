{
  "name": "bruce-banner",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Mobile promo banners for Ipoteka Bank, RU/UZ/EN, with AI copy and illustrations, built on Maga UI",
  "scripts": {
    "vendor": "NODE_USE_ENV_PROXY=1 node scripts/vendor-legacy.mjs",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "e2e:parity": "node tests/e2e/parity.mjs",
    "e2e:fonts": "node tests/e2e/fonts.mjs",
    "e2e:app": "node tests/e2e/app.mjs",
    "e2e:ai": "node tests/e2e/ai.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "1.56.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0"
  }
}
