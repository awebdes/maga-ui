# Copy to .env.local for `npm run dev`; on Vercel set these in Project Settings → Environment Variables.
# Without GEMINI_API_KEY (or with AI_MOCK=1) every AI endpoint answers from deterministic mocks.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# 1 = send three brand illustrations as style references with every image request
GEMINI_STYLE_REFS=0
# Comma-separated access codes; empty = no code required
BANNER_ACCESS_CODES=
# Comma-separated extra allowed origins for /api/ai/* (the deployment's own origin is always allowed)
BANNER_ALLOWED_ORIGINS=
AI_MOCK=0
